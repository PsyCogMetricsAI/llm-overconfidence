    "ALS": {
      "objective": "min sum_(m,i valid) (ell_mi-a_m+s_m*b_i)^2; unweighted source observed cells",
      "reference_items": "source F items with >=20 valid reference Q0 models; noneligible b=NaN",
      "reference_min_qualified_items": 100,
      "reference_models": "all Q0 rows in exact reference org set; any row <2 eligible items => diagnostic failure, not implicit drop",
      "initialization": "b=standardize(-mean_valid_models ell per eligible item), population SD",
      "model_update": "s_m=-Cov_valid(b,ell_m)/Var_valid(b); a_m=mean(ell_m)+s_m*mean(b)",
      "item_update": "raw_b_i=sum_valid s_m*(a_m-ell_mi)/sum_valid s_m^2",
      "gauge": "mu=mean(raw_b),sd=std(raw_b,ddof0); b=(raw_b-mu)/sd; a_new=a_old-s_old*mu; s_new=s_old*sd; if dot(b,initial_b)<0 negate b and s",
      "convergence": "max_abs(b_new-b_old)<1e-6; <=500 iterations; nonconvergence diagnostic failure; no changing seed/tol or silently dropping",
      "post_convergence": "recompute model OLS and report normal intercept/slope, objective/history, iterations, mean_b,var_b,sign_dot",
      "degeneracy_boundaries": {
        "init_or_gauge_sd_le": 1e-12,
        "model_var_b_le": 1e-12,
        "item_s_squared_denominator_le": 1e-20
      }
    },
    "projection": {
      "items": "scored model valid source F intersect finite reference b only",
      "s": "-population_cov(b,ell)/population_var(b)",
      "a": "mean(ell)+s*mean(b)",
      "theta": "a/s",
      "sigma": "sqrt(mean((ell-a+s*b)^2)); residual RMS with fitted intercept, population SD; not logistic scale",
      "logs": "natural log(s), natural log(sigma)",
      "eligible": "n_valid_qualifiedF>=100 AND Var(b)>1e-12 AND Var(ell)>1e-6 AND finite s>1e-8 AND finite sigma>1e-8 AND finite theta; all9 source summaries finite",
      "target_data": "no target items, target valid counts, target statistics, org labels as predictor columns"
    },
    "two_stage_qualification": {
      "Q0": "ARC/HS metadata threshold qualified fixed snapshot; used to freeze all splits and reference membership",
