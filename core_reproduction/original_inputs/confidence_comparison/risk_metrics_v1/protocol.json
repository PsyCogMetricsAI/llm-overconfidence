  "source_contract": {
    "scope": "ARC source only; all valid items F union C for traditional statistics; only F half for response parameters",
    "observation": {
      "real_options": "n_options agrees with finite positive char_lens; padding has no finite loglik; all real option loglik finite; >=2 options; legal integer gold; unique item and model IDs",
      "u": "L_k/h_k; h_k stored positive finite character length; no token/raw-L substitution or length imputation",
      "p": "exp(u_k-max(u))/sum exp(u_j-max(u)); real options only",
      "argmax": "smallest original option index among exact ties",
      "y": "1[argmax(u)==gold]; never 1[ell>0]",
      "c": "max_k p_k",
      "ell": "u_gold-logsumexp(u_nongold)",
      "invalid": "invalid item excluded for all source statistics and source fit; invalid rows explicitly masked, not zero-filled as observations"
    },
    "statistics": {
      "A": "mean_i y_i",
      "C": "mean_i c_i",
      "O": "C-A",
      "bins": "10 equal-width [b/10,(b+1)/10), b=0..8; last [0.9,1]; empty bin contributes0; bin=min(floor(10*c),9)",
      "REL10": "sum_b n_b/N*(mean(c_b)-mean(y_b))^2",
      "ECE10": "sum_b n_b/N*abs(mean(c_b)-mean(y_b))",
      "Brier": "mean_i sum_k (p_ik-1[k=gold_i])^2; no division by K",
      "H": "mean_i -sum_k(p_ik*log(p_ik))/log(K_i); natural log; 0log0=0",
      "Margin": "mean_i sorted(p_i,descending)[0]-sorted(p_i,descending)[1]",
      "R50": "mean error among ceil(N/2) items ordered c descending then canonical item ID ascending"
    },
